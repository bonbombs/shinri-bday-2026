{
  "name": "shinri-bday-2026",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "watch:eleventy": "npx @11ty/eleventy --serve",
    "watch:sass": "npx sass sass:_site/css --watch",
    "start": "npm run watch:eleventy & npm run watch:sass",
    "build": "npm run clean-before && npx @11ty/eleventy && npx sass sass:_site/css && npm run clean-after",
    "clean-before": "rimraf _site",
    "clean-after": "rimraf --glob '_site/**/index.html#post-*'",
    "debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
    "debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
    "benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-bundle": "^3.0.7",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "cross-env": "^10.1.0",
    "lodash": "^4.17.23",
    "luxon": "^3.7.2",
    "markdown-it-container": "^4.0.0",
    "sass": "^1.97.3"
  },
  "devDependencies": {
    "rimraf": "^6.1.3"
  }
}
