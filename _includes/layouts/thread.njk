---
layout: layouts/base.njk
---
<link rel="stylesheet" href="{{ "/css/posts.css" }}" />

<header>
    <h1>{{ title }}</h1>
    {# <span><time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time></span> #}
</header>
<div class="post-metadata">
	
	{# {%- for tag in tags | filterTagList %}
	{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
	<li><a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>{%- if not loop.last %}, {% endif %}</li>
	{%- endfor %} #}
</div>

<table style="border:1px solid;     border-collapse: collapse;">
{% for post in collections.postsByThread[id] %}
    {% set userid = post.data.user %}
    {% set userdata = users | findUser(userid) %}
    {% set postcontent = post.content %}
    {% set header %}
        <div>post #{{loop.index}} by 
            <span>{{ userdata.username }}</span> » 
            <time datetime="{{post.data.date}}">{{post.data.date | htmlDateTime }}</time>
        </div>
    {% endset %}
    {% include "layouts/post.njk" %}
{% endfor %}
</table>
{# {%- set previousPost = page.data | getPreviousCollectionItem %}
{%- set nextPost = page.data | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<ul class="links-nextprev">
	{%- if previousPost %}<li class="links-nextprev-prev">← Previous<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
	{%- if nextPost %}<li class="links-nextprev-next">Next →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
</ul>
{%- endif %} #}