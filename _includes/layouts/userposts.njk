---
layout: layouts/base.njk
---
<link rel="stylesheet" href="{{ "/css/posts.css" }}" />

{% set user = users | findUser(id) %}
<header>
    <h1>posts by {{ user.username }}</h1>
    {# <span><time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time></span> #}
</header>
<div class="post-metadata">
	
	{# {%- for tag in tags | filterTagList %}
	{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
	<li><a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>{%- if not loop.last %}, {% endif %}</li>
	{%- endfor %} #}
</div>

<div>
{% for post in collections.postsByUser[id] | reverse %}
    {% set userid = post.data.user %}
    {% set userdata = users | findUser(userid) %}
    {% set postcontent = post.content %}
    {% set postid %}post-0{{loop.index}}{%endset%}
    {% set t = (collections.thread | findThread(post.data.thread)) %}
    {% set header %}
    <a href="{{post.page.url}}">{{t.data.title}}</a>
    {% endset %}
    {% include "layouts/post.njk" %}
{% endfor %}
</div>